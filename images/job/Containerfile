# The build Job's `fetch` and `build` containers: BuildKit's own image, for `buildctl`, `git` and
# `ssh`, plus the static `zeabur-builder-job` wrapper. Built by scripts/build-images.sh.
ARG BUILDKIT=docker.io/moby/buildkit:v0.34.1
FROM ${BUILDKIT}
# The Job runs as 1000 (jobspec RUN_AS), and OpenSSH refuses a user /etc/passwd does not list.
RUN echo 'zeabur:x:1000:1000::/tmp:/sbin/nologin' >> /etc/passwd \
 && echo 'zeabur:x:1000:' >> /etc/group
COPY --chmod=0555 zeabur-builder-job /usr/bin/zeabur-builder-job
