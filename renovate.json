{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Cargo crates and action digests. The Rust nightly and flake.lock are updated by .github/workflows/update-toolchain.yml, which also has to update the fenix hash in flake.nix.",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Taipei",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "labels": [
    "dependencies"
  ],
  "commitBody": "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "enabledManagers": [
    "cargo",
    "github-actions"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-5 * * 1"
    ]
  },
  "packageRules": [
    {
      "description": "One pull request for compatible crate updates; majors stay separate.",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "cargo (non-major)"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    }
  ]
}
