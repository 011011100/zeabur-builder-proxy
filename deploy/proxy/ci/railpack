#!/usr/bin/env python3
"""A CI planner fixture; the actual pinned Railpack frontend still builds the plan."""
import json
from pathlib import Path
import sys
import urllib.request


arguments = sys.argv[1:]
if len(arguments) < 2 or arguments[0] != "prepare":
    raise SystemExit("CI planner supports only railpack prepare CONTEXT")
context = Path(arguments[1])
with urllib.request.urlopen("http://probe.proxy-test.invalid/check?phase=planner", timeout=10) as response:
    if response.read().strip() != b"proxy-smoke-ok":
        raise SystemExit("planner proxy probe did not succeed")
for flag, content in (("--plan-out", (context / "railpack-plan.json").read_text()),
                      ("--info-out", json.dumps({"fixture": "proxy-smoke"}))):
    target = Path(arguments[arguments.index(flag) + 1])
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content)
